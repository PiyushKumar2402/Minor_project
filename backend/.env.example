PORT=5000
MONGO_URI=mongodb://localhost:27017/doctor_appointment_system
JWT_SECRET=replace_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# Zoom integration (Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_TIMEZONE=Asia/Kolkata
# true = clearly-marked DEMO meeting links without calling Zoom
ZOOM_MOCK=true

# Gmail notifications (Stage 7)
# GMAIL_APP_PASSWORD must be a Google "App Password", not your normal password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Shown in the email header, and as the hospital name on in-person confirmations
HOSPITAL_NAME=ABC Hospital
